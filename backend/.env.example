# ===== RecoveryAI backend configuration =====
# Copy to .env and adjust. NEVER commit real secrets.

APP_NAME=RecoveryAI
ENVIRONMENT=local
DEBUG=true

# Database: PostgreSQL (docker-compose) or local SQLite fallback.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://recovery:recovery@localhost:5432/recovery_ai
DATABASE_URL=sqlite:///./recovery_ai.db

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_USER_EMAIL=merchant@recovery.ai
DEMO_USER_PASSWORD=demo1234

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Webhook signature verification (HMAC-SHA256 over raw body)
WEBHOOK_SECRET=demo-webhook-secret
ALLOW_UNSIGNED_WEBHOOKS=true

# LLM provider: mock | openai | groq  (mock requires no API key)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Rate limiting (requests/minute per IP)
RATE_LIMIT_PER_MINUTE=600

# Recovery scoring weights (must sum to 100): value, failure_frequency,
# customer_value, historical_success, probability, recency
SCORING_WEIGHTS={"value":25,"failure_frequency":10,"customer_value":20,"historical_success":10,"probability":25,"recency":10}
